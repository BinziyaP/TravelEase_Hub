@startuml TravelEase_Sequence_Diagram

title TravelEase System - Sequence Diagram

actor "Regular User" as User
actor "Travel Agency" as Agency
actor "Administrator" as Admin
participant "System" as System
database "Database" as DB

== User Registration and Login ==

User -> System: Register Account
activate System
System -> DB: Insert User Data
activate DB
DB --> System: Confirmation
deactivate DB
System --> User: Registration Confirmation
deactivate System

User -> System: Login
activate System
System -> System: Validate User Data
System -> DB: Retrieve User Data
activate DB
DB --> System: User Data
deactivate DB
System --> User: Login Confirmation
deactivate System

== User Viewing and Booking Packages ==

User -> System: View Travel Packages
activate System
System -> DB: Retrieve Travel Packages
activate DB
DB --> System: Packages Data
deactivate DB
System --> User: Display Travel Packages
deactivate System

User -> System: Book Travel Package
activate System
System -> DB: Insert Booking Data
activate DB
DB --> System: Booking Confirmation
deactivate DB
System --> User: Booking Confirmation
deactivate System

== User Making Payment ==

User -> System: Process Payment
activate System
System -> DB: Insert Payment Data
activate DB
DB --> System: Payment Confirmation
deactivate DB
System --> User: Payment Confirmation
deactivate System

== Agency Package Management ==

Agency -> System: Register as Agency
activate System
System -> DB: Insert Agency Data
activate DB
DB --> System: Agency Registration Confirmation
deactivate DB
System --> Agency: Registration Confirmation
deactivate System

Agency -> System: Create Travel Package
activate System
System -> DB: Insert Package Data
activate DB
DB --> System: Package Creation Confirmation
deactivate DB
System --> Agency: Package Created
deactivate System

Agency -> System: View Package Bookings
activate System
System -> DB: Retrieve Package Bookings
activate DB
DB --> System: Bookings Data
deactivate DB
System --> Agency: Display Bookings
deactivate System

== Admin Management ==

Admin -> System: Approve Agency Registration
activate System
System -> DB: Update Agency Status
activate DB
DB --> System: Update Confirmation
deactivate DB
System --> Admin: Agency Approved
deactivate System

Admin -> System: Approve Travel Package
activate System
System -> DB: Update Package Status
activate DB
DB --> System: Update Confirmation
deactivate DB
System --> Admin: Package Approved
deactivate System

Admin -> System: View System Statistics
activate System
System -> DB: Retrieve Statistics Data
activate DB
DB --> System: Statistics Data
deactivate DB
System --> Admin: Display Statistics
deactivate System

@enduml






